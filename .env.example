# All values are optional for local development of the intake flow and eligibility engine.
# Features that need a missing value degrade gracefully (see README, "Configuration").

# Claude: plain-English analysis of the deterministic result, and the weekly data-update script.
ANTHROPIC_API_KEY=

# Supabase: stores intake submissions and email leads. Without these, nothing is persisted.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for Stripe redirect URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Stripe: only used by the dormant paid-report routes (/api/checkout, /api/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
